<Window x:Class="TheReadme.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="The Readme" Width="1240" Height="800" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen" WindowStyle="None" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="{DynamicResource Ink}"
        Background="{DynamicResource Base}" Icon="Assets/readme.ico" AllowDrop="True"
        PreviewKeyDown="HandleKey" PreviewMouseDown="DismissSettingsOnClick" PreviewMouseWheel="ZoomWithWheel"
        Deactivated="DismissSettingsOnDeactivate" PreviewDragOver="CheckDrop" Drop="OpenDropped">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="43" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Base" Color="#F8F7FC"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Soft" Color="#F0EDF8"/>
    <SolidColorBrush x:Key="Line" Color="#DFDAEA"/>
    <SolidColorBrush x:Key="Ink" Color="#211B2F"/>
    <SolidColorBrush x:Key="Muted" Color="#635B71"/>
    <SolidColorBrush x:Key="Accent" Color="#6243BD"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hover" Color="#E7E1F5"/>
    <Style x:Key="Focus" TargetType="Control">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate><Border BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="9" Margin="-2"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="13,7"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border CornerRadius="8" Background="{TemplateBinding Background}"/>
              <Border x:Name="HoverLayer" CornerRadius="8" Background="{DynamicResource Hover}" Opacity="0"/>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverLayer" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="HoverLayer" Property="Opacity" Value="1"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="17,9"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Width" Value="37"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="46"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style x:Key="RailItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Tile" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Soft}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate><Border Background="Transparent"/></ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical">
          <Setter Property="Width" Value="11"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/>
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb MinHeight="24">
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border x:Name="ThumbPaint" Background="{DynamicResource Muted}" Opacity="0.45" CornerRadius="4" Margin="2,1"/>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbPaint" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbPaint" Property="Opacity" Value="1"/></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/>
                  </Track.IncreaseRepeatButton>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Border x:Name="Frame" BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="43"/>
        <RowDefinition Height="53"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="33"/>
      </Grid.RowDefinitions>
      <DockPanel Background="{DynamicResource Base}" LastChildFill="True">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeWindow" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
          <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="ToggleMaximize" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore"/>
          <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="CloseWindow" ToolTip="Close" AutomationProperties.Name="Close"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="17,0,0,0" VerticalAlignment="Center">
          <Image Source="Assets/readme.ico" Width="23" Height="23" Margin="0,0,8,0"/>
          <TextBlock Text="The Readme" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text=" / " Foreground="{DynamicResource Muted}" Margin="8,0,6,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="Caption" Text="Home" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>

      <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1">
        <DockPanel Margin="13,0" VerticalAlignment="Center" LastChildFill="False">
          <Button x:Name="RailButton" Style="{StaticResource IconButton}" Content="&#xE700;" Click="ToggleRail" DockPanel.Dock="Left"
                  ToolTip="Toggle sidebar (Ctrl+B)" AutomationProperties.Name="Toggle sidebar"/>
          <Button Content="Open file" Click="PickFile" DockPanel.Dock="Left" Margin="4,0,0,0" ToolTip="Open a file (Ctrl+O)"/>
          <Button Content="New" Click="NewDocument" DockPanel.Dock="Left" ToolTip="New Markdown document (Ctrl+N)"/>
          <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Content="&#xE72C;" Click="Reload" DockPanel.Dock="Left"
                  ToolTip="Reload file (F5)" AutomationProperties.Name="Reload file" IsEnabled="False"/>
          <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;" Click="ToggleSettings" DockPanel.Dock="Right"
                  ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings"/>
          <Button x:Name="FindButton" Style="{StaticResource IconButton}" Content="&#xE721;" Click="OpenFind" DockPanel.Dock="Right"
                  ToolTip="Find in document (Ctrl+F)" AutomationProperties.Name="Find in document" IsEnabled="False"/>
          <Border x:Name="ViewModes" Background="{DynamicResource Soft}" CornerRadius="9" DockPanel.Dock="Right" Margin="0,0,9,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Margin="2">
              <Button x:Name="ReadButton" Content="Read" Click="ShowRendered" MinHeight="28" Padding="12,4" IsEnabled="False"/>
              <Button x:Name="SourceButton" Content="Edit" Click="ShowSource" MinHeight="28" Padding="12,4" IsEnabled="False"/>
              <Button x:Name="SplitButton" Content="Split" Click="ShowSplit" MinHeight="28" Padding="12,4" IsEnabled="False"/>
            </StackPanel>
          </Border>
        </DockPanel>
      </Border>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailWidth" Width="219"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="Rail" Background="{DynamicResource Base}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="16,24,14,15">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="RailHeading" Text="Recent files" FontWeight="SemiBold" Margin="8,0,0,12"/>
            <TextBlock Grid.Row="1" x:Name="RailEmpty" Text="Files you open appear here." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="13" Margin="8,3,5,0"/>
            <ListBox Grid.Row="1" x:Name="RailList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource RailItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SelectRail" AutomationProperties.Name="Document outline or recent files">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Label}" Margin="{Binding Indent}" ToolTip="{Binding Hint}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Separator Grid.Row="2" x:Name="HomeDivider" Background="{DynamicResource Line}" Margin="7,14,5,10"/>
            <Button Grid.Row="3" x:Name="HomeButton" Content="←  Home" Click="GoHome" HorizontalContentAlignment="Left" ToolTip="Return to Home"/>
          </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource Surface}">
          <ScrollViewer x:Name="Welcome" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="860" Margin="34,26">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border CornerRadius="17" ClipToBounds="True" SizeChanged="ClipHero" Background="#211638" MinHeight="306">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Grid.Column="1">
                    <Border.Background><ImageBrush ImageSource="Assets/cover.jpg" Stretch="UniformToFill"/></Border.Background>
                  </Border>
                  <Border Grid.Column="1">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0.30,0"><GradientStop Color="#FF211638" Offset="0"/><GradientStop Color="#00211638" Offset="1"/></LinearGradientBrush>
                    </Border.Background>
                  </Border>
                  <StackPanel VerticalAlignment="Center" Margin="31,26,0,24">
                    <TextBlock Text="A place to&#x0a;read well." Foreground="#FFF9FF" FontSize="42" LineHeight="47"
                               FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Write Markdown. Read source files." Foreground="#EBDEF8" TextWrapping="Wrap" Margin="0,14,10,18"/>
                    <Button Content="Open a file" Style="{StaticResource Primary}" Click="PickFile" HorizontalAlignment="Left" />
                  </StackPanel>
                </Grid>
              </Border>
              <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Base}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="13" Padding="16,13">
                  <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="Try a sample →" Click="OpenSample" HorizontalAlignment="Left" Margin="-10,7,0,0"/>
                    <StackPanel>
                      <TextBlock Text="Markdown &amp; text" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock Text="Edit, format, and preview a README." Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource Base}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="13" Padding="16,13">
                  <StackPanel>
                    <TextBlock Text="Source &amp; data" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Edit Python, C++, Java, HDL, JSON, and more." Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <WrapPanel Margin="-10,7,0,0">
                      <Button Content="Open a Python example →" Click="OpenCodeSample"/>
                      <Button Content="Open an HDL example →" Tag="HDL" Click="OpenCodeSample"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </Grid>
              <Border Grid.Row="2" Background="{DynamicResource Base}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="13" Margin="0,12,0,0" Padding="16,11">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="19" VerticalAlignment="Center" Margin="1,0,13,0" Foreground="{DynamicResource Accent}"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Drop a file here" FontWeight="SemiBold"/>
                    <TextBlock Text="Drag a document or source file in from File Explorer." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </Grid>
          </ScrollViewer>

          <Grid x:Name="DocumentArea" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Padding="30,14,19,11" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock x:Name="FileTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="FileLocation" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                  <Button x:Name="SaveButton" Content="Save" Click="SaveClicked" ToolTip="Save (Ctrl+S)"/>
                  <Button x:Name="SaveAsButton" Content="Save as…" Click="SaveAsClicked" ToolTip="Save as (Ctrl+Shift+S)"/>
                  <Button x:Name="RevealButton" Style="{StaticResource IconButton}" Content="&#xE838;" Click="RevealFile"
                          ToolTip="Show in File Explorer" AutomationProperties.Name="Show in File Explorer"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border x:Name="FindBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Base}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="15,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Find" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="FindBox" Width="195" MaxLength="512" VerticalContentAlignment="Center" TextChanged="SearchChanged" AutomationProperties.Name="Find in document"/>
                <TextBlock x:Name="FindCount" MinWidth="79" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" AutomationProperties.LiveSetting="Polite"/>
                <Button Content="↑" Click="FindPrevious" ToolTip="Previous match (Shift+Enter)" AutomationProperties.Name="Previous match"/>
                <Button Content="↓" Click="FindNext" ToolTip="Next match (Enter)" AutomationProperties.Name="Next match"/>
                <Button x:Name="CloseFindButton" Content="×" Click="CloseFind" ToolTip="Close find (Esc)" AutomationProperties.Name="Close find"/>
              </StackPanel>
            </Border>
            <Border x:Name="EditorTools" Grid.Row="2" Visibility="Collapsed" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="9,4">
              <WrapPanel>
                <StackPanel x:Name="FormattingTools" Orientation="Horizontal">
                  <Button x:Name="BoldButton" Content="B" FontWeight="Bold" Tag="**" Click="FormatInline" ToolTip="Bold (Ctrl+Shift+B)" AutomationProperties.Name="Toggle bold"/>
                  <Button Content="I" FontStyle="Italic" Tag="*" Click="FormatInline" ToolTip="Italic (Ctrl+I)" AutomationProperties.Name="Toggle italic"/>
                  <Button x:Name="UnderlineButton" Tag="++" Click="FormatInline" ToolTip="Underline (Ctrl+U). Uses the ++ Markdown extension." AutomationProperties.Name="Toggle underline">
                    <TextBlock Text="U" TextDecorations="Underline"/>
                  </Button>
                  <Button Content="Strike" Tag="~~" Click="FormatInline" ToolTip="Strikethrough" AutomationProperties.Name="Toggle strikethrough"/>
                  <Button Content="Code" Tag="`" Click="FormatInline" ToolTip="Inline code" AutomationProperties.Name="Toggle inline code"/>
                  <Button Content="Text style ▾" Click="OpenHeadingMenu" ToolTip="Change heading size or return to body text" AutomationProperties.Name="Text style">
                    <Button.ContextMenu>
                      <ContextMenu Placement="Bottom" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}">
                        <MenuItem Header="Title" Tag="1" Click="ChooseHeading"/>
                        <MenuItem Header="Heading" Tag="2" Click="ChooseHeading"/>
                        <MenuItem Header="Subheading" Tag="3" Click="ChooseHeading"/>
                        <Separator/>
                        <MenuItem Header="Body text" Tag="0" Click="ChooseHeading"/>
                      </ContextMenu>
                    </Button.ContextMenu>
                  </Button>
                </StackPanel>
                <TextBlock x:Name="SourceKind" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="8,0,7,0"/>
                <Button x:Name="WrapButton" Content="Wrap lines" Click="ToggleWrap" ToolTip="Toggle line wrapping"/>
                <Button x:Name="GoToButton" Content="Go to line" Click="OpenGoTo" ToolTip="Go to line (Ctrl+G)"/>
                <StackPanel x:Name="LineEntry" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                  <TextBox x:Name="LineBox" Width="65" MaxLength="7" AutomationProperties.Name="Line number" VerticalContentAlignment="Center"/>
                  <Button Content="Go" Click="GoToClicked" AutomationProperties.Name="Jump to line"/>
                </StackPanel>
              </WrapPanel>
            </Border>
            <Grid x:Name="DocumentSurface" Grid.Row="3" SizeChanged="DocumentResized">
              <Grid.ColumnDefinitions><ColumnDefinition x:Name="EditorColumn" Width="0"/><ColumnDefinition x:Name="SplitColumn" Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition x:Name="EditorRow" Height="0"/><RowDefinition x:Name="SplitRow" Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border x:Name="EditorDivider" Background="{DynamicResource Line}" Visibility="Collapsed"/>
              <FlowDocumentScrollViewer x:Name="Preview" Grid.Column="2" Grid.Row="2" Margin="26,10,16,0" VerticalScrollBarVisibility="Auto"
                    IsSelectionEnabled="True" IsInactiveSelectionHighlightEnabled="True" SelectionBrush="{DynamicResource Accent}"
                    MinZoom="60" MaxZoom="220" IsToolBarVisible="False" AutomationProperties.Name="Markdown preview"/>
              <TextBox x:Name="Source" Grid.Column="2" Grid.Row="2" Margin="14,8,12,10" Padding="12" IsReadOnly="True"
                     IsInactiveSelectionHighlightEnabled="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                     FontFamily="Cascadia Mono, Consolas" BorderThickness="0" TextChanged="SourceChanged" MaxLength="2097152" UndoLimit="75"
                     AutomationProperties.Name="Document text"/>
            </Grid>
          </Grid>

          <Border x:Name="SettingsPane" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="13" Width="360" MaxHeight="535"
                  Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}"
                  BorderThickness="1" CornerRadius="13" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <DockPanel Margin="0,0,0,8">
                  <Button DockPanel.Dock="Right" Content="×" Click="ToggleSettings" AutomationProperties.Name="Close settings"/>
                  <TextBlock Text="Settings" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Reading theme" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <WrapPanel x:Name="ThemeButtons" Margin="0,0,0,12"/>
                <Separator Background="{DynamicResource Line}"/>
                <TextBlock Text="Editing and motion" FontWeight="SemiBold" Margin="0,7,0,5"/>
                <CheckBox x:Name="AutoIndentToggle" Content="Keep indentation on new code lines" Foreground="{DynamicResource Ink}" Margin="2,2,0,6" Click="ChangeEditorOptions"/>
                <CheckBox x:Name="MotionToggle" Content="Animate transitions" Foreground="{DynamicResource Ink}" Margin="2,2,0,12" Click="ChangeEditorOptions"/>
                <Separator Background="{DynamicResource Line}"/>
                <TextBlock Text="Windows integration" FontWeight="SemiBold" Margin="0,7,0,1"/>
                <Button Content="Set as default app ↗" Click="OpenDefaultApps" HorizontalContentAlignment="Left" Padding="4,5"/>
                <Button x:Name="PathButton" Content="Add to PATH" Click="TogglePath" HorizontalContentAlignment="Left" Padding="4,5"/>
                <TextBlock x:Name="PathHint" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,12"/>
                <Separator Background="{DynamicResource Line}"/>
                <CheckBox x:Name="RecentToggle" Content="Remember recent files" Foreground="{DynamicResource Ink}" Margin="2,11,0,2" Click="ChangeRecent"/>
                <Button Content="Clear recent files" Click="ClearRecent" HorizontalContentAlignment="Left" Padding="4,5"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>

      <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Base}">
        <DockPanel Margin="13,0">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button Content="−" Click="ZoomOut" MinHeight="25" Padding="9,2" ToolTip="Zoom out (Ctrl+−)" AutomationProperties.Name="Zoom out"/>
            <Button x:Name="ZoomLabel" Content="100%" Click="ZoomReset" MinHeight="25" MinWidth="57" Padding="5,2" ToolTip="Reset zoom (Ctrl+0)" AutomationProperties.Name="Reset zoom"/>
            <Button x:Name="ZoomInButton" Content="+" Click="ZoomIn" MinHeight="25" Padding="9,2" ToolTip="Zoom in (Ctrl++)" AutomationProperties.Name="Zoom in"/>
          </StackPanel>
          <TextBlock x:Name="Status" Text="Ready to read" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}"
                     TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
